DATABASE_URL="mongodb+srv://<username>:<password>@<cluster-url>/<db-name>?retryWrites=true&w=majority"
# Use http://localhost:3000 for dev; use your production URL (e.g. https://your-domain.com) for production
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="<generate-a-long-random-secret>"
SEED_USER_EMAIL="admin@siouxclub.com"
SEED_USER_PASSWORD="<min-8-chars-password>"
SEED_USER_NAME="Admin User"
SEED_USER_ROLE="ADMIN"

# Vercel Cron: must match Authorization: Bearer <CRON_SECRET> (set in Vercel → Environment Variables)
CRON_SECRET="<long-random-string>"
# Optional: base URL for `npm run cron:test` (defaults to http://localhost:3000)
# CRON_TEST_BASE_URL="http://localhost:3000"

# SMTP (e.g. Gmail App Password)
MAIL_FROM="SBC <noreply@sbc.com>"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="<app-password>"
